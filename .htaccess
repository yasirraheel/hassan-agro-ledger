<IfModule mod_rewrite.c>
    RewriteEngine On
    # If request is not already in /public
    RewriteCond %{REQUEST_URI} !^/public/
    # Redirect everything to /public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

